<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.edu.ifma.labmanager</groupId>
    <artifactId>labmanager</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LabManager (TCC)</name>
    <description>Sistema de pesquisa — Clean Architecture e desacoplamento em microsserviços</description>

    <modules>
        <module>services/scheduling-service-clean</module>
        <module>architecture-metrics</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.4.1</archunit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.edu.ifma.labmanager</groupId>
                <artifactId>scheduling-clean-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifma.labmanager</groupId>
                <artifactId>scheduling-clean-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifma.labmanager</groupId>
                <artifactId>scheduling-clean-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.edu.ifma.labmanager</groupId>
                <artifactId>scheduling-clean-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
